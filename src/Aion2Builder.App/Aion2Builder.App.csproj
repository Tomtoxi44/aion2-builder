<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Aion2Builder</AssemblyName>
    <!-- Icône du .exe (Explorateur, raccourci) ; la fenêtre la relit comme ressource intégrée (pas de ressource Avalonia). -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Compilation locale : 0.0.0 (pas de mise à jour proposée). GitHub passe -p:Version=1.1.N. -->
    <Version>0.0.0</Version>
    <!-- Métadonnées de l'exe (Propriétés → Détails), exigées par SignPath sur les fichiers signés. -->
    <Product>Aion 2 Builder</Product>
    <AssemblyTitle>Aion 2 Builder</AssemblyTitle>
    <Company>A.Tommy</Company>
    <Description>Aion 2 Builder : conseils de build pour AION 2</Description>
    <Copyright>Copyright (c) 2026 A.Tommy. Licence MIT.</Copyright>
    <!-- Version produit = 1.1.N exactement (sans « +commit ») : SignPath la contrôle à la signature. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    Interface écrite en C# (pas de .axaml) : le compilateur XAML d'Avalonia est une DLL non signée
    que Smart App Control bloque à la compilation. Sans fichier XAML ni ressource Avalonia, cette
    étape ne s'exécute pas.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aion2Builder.Core\Aion2Builder.Core.csproj" />
  </ItemGroup>
</Project>
